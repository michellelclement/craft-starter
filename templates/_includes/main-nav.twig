{% set navItems = craft.navigation.nodes().handle('navigation').all() %}

<nav class="py-20 bg-gray-200">
  <div class="container">
    <nav>
      <ul>
        {% for item in navItems %}
          <li>
            <a href="{{ item.url}}">{{ item.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</nav>
