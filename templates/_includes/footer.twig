{% set footerNavItems = craft.navigation.nodes().handle('footerNavigation').all() %}

<footer class="py-20 bg-gray-200">
  <div class="container">
    <nav>
      <ul>
        {% for item in footerNavItems %}
          <li>
            <a href="{{ item.url}}">{{ item.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</footer>
